{
  "name": "builtnorth/wp-config",
  "description": "Adds configuration functionality to WordPress. Based off of Roots/WPConfig.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Built North",
      "homepage": "https://builtnorth.co"
    },
    {
      "name": "Dan Northern",
      "homepage": "https://dannorthern.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "vlucas/phpdotenv": "^5.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "mockery/mockery": "^1.5",
    "builtnorth/coding-standards": "*"
  },
  "autoload": {
    "psr-4": {
      "BuiltNorth\\WPConfig\\": "inc/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BuiltNorth\\WPConfig\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit",
    "test:coverage": "phpunit --coverage-html coverage",
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "phpcs": "phpcs",
    "phpcs:summary": "phpcs --report=summary",
    "phpcbf": "phpcbf",
    "phpcompat": "phpcs -p inc --standard=PHPCompatibility --runtime-set testVersion 8.1-"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
